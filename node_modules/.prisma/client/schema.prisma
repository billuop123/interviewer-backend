// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id       String   @id @default(uuid())
  name     String   @unique
  code     String
  created  DateTime @default(now())
  modified DateTime @updatedAt
  users    users[]
}

model users {
  id          String         @id @default(uuid())
  name        String
  email       String         @unique
  password    String
  phone       String?
  roleId      String
  companyId   String?
  created     DateTime       @default(now())
  updated     DateTime?
  deleted     DateTime?
  userdetails userdetails?
  job         jobs[]
  application applications[]
  company     companies?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        roles          @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model userdetails {
  id              String    @id @default(uuid())
  userId          String    @unique
  experience      Int?
  phone           String?   @unique
  resumelink      String?
  skills          String[]
  location        String?
  bio             String?
  linkedin        String?
  portfolio       String?
  github          String?
  expected_salary Int?
  availability    String?
  created         DateTime  @default(now())
  updated         DateTime?
  deleted         DateTime?
  user            users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model companytypes {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created     DateTime  @default(now())
  modified    DateTime  @updatedAt
  deleted     DateTime?
}

model loginfo {
  id          String    @id @default(uuid())
  message     String
  description String
  severity    String
  userId      String?
  created     DateTime  @default(now())
  updated     DateTime?
  delete      DateTime?
}

model companysettings {
  id              String    @id @default(uuid())
  companyId       String
  key             String
  value           Boolean   @default(true)
  isSystemSetting Boolean   @default(false)
  created         DateTime  @default(now())
  updated         DateTime?
  deleted         DateTime?
  companies       companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

model companies {
  id          String            @id @default(uuid())
  name        String
  email       String?           @unique
  website     String?
  logo        String?
  postlimit   Int?
  blacklisted Boolean           @default(false)
  created     DateTime          @default(now())
  updated     DateTime?
  deleted     DateTime?
  job         jobs[]
  settings    companysettings[]
  user        users[]
}

model jobtypes {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created     DateTime  @default(now())
  modified    DateTime? @updatedAt
  deleted     DateTime?
  job         jobs[]
}

model jobs {
  id               String   @id @default(uuid())
  title            String
  description      String
  companyid        String
  jobtypeid        String
  location         String?
  isremote         Boolean  @default(false)
  salarymin        Decimal? @db.Decimal(12, 2)
  salarymax        Decimal? @db.Decimal(12, 2)
  salarycurrency   String   @default("USD")
  requirements     String?
  responsibilities String?
  benefits         String?
  applicationUrl   String?

  contactemail        String?   @db.VarChar(255)
  applicationdeadline DateTime?
  experiencerequired  Int?
  educationlevel      String?   @db.VarChar(100)
  skills              String[]
  isactive            Boolean   @default(true)
  viewscount          Int       @default(0)
  applicationscount   Int       @default(0)
  isfeatured          Boolean   @default(false)
  postedby            String?
  created             DateTime  @default(now())
  updated             DateTime?
  deleted             DateTime?

  company      companies      @relation(fields: [companyid], references: [id], onDelete: Cascade)
  jobtype      jobtypes       @relation(fields: [jobtypeid], references: [id], onDelete: Restrict)
  postedBy     users?         @relation(fields: [postedby], references: [id], onDelete: SetNull)
  applications applications[]
}

// model applicationstatus{
//   id String @id @default(uuid())
//   name String @unique
//   code String
//   modified     DateTime?
//   deleted      DateTime?
//   applications applications[]
// }
model applications {
  id               String    @id @default(uuid())
  jobid            String
  userid           String
  videolink        String?
  coverletter      String?
  relevancescore   Decimal?  @db.Decimal(3, 2)
  relevancecomment String?
  interviewdate    DateTime?
  notes            String?
  created          DateTime  @default(now())
  updated          DateTime?
  deleted          DateTime?
  job              jobs      @relation(fields: [jobid], references: [id], onDelete: Cascade)
  user             users     @relation(fields: [userid], references: [id], onDelete: Cascade)
  // status applicationstatus @relation(fields: [applicationstatusid], references: [id], onDelete: Restrict)
}

model emailtemplates {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  subject     String    @db.VarChar(255)
  body        String
  description String?
  created     DateTime  @default(now())
  updated     DateTime? @updatedAt
  deleted     DateTime?
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailTracking {
  id          String      @id @default(uuid())
  recipientId String
  templateId  String
  emailStatus EmailStatus @default(SENT)
  created     DateTime    @default(now())
  modified    DateTime?   @updatedAt
  deleted     DateTime?
}
